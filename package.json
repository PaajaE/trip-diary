{
  "name": "trip-diary",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:packages": "pnpm -r --filter './packages/*' test",
    "dev": "vite",
    "dev:prod": "vite --mode production",
    "build": "pnpm typecheck && vite build",
    "native:sync": "pnpm build && cap sync",
    "native:assets": "capacitor-assets generate --ios --android --iconBackgroundColor '#f7f4ed' --iconBackgroundColorDark '#20231f' --splashBackgroundColor '#f7f4ed' --splashBackgroundColorDark '#20231f' --logoSplashScale 0.38",
    "native:doctor": "cap doctor",
    "native:ios": "pnpm native:sync && cap open ios",
    "native:android": "pnpm native:sync && cap open android",
    "native:android:run": "bash scripts/android-run.sh",
    "native:android:logs": "bash scripts/android-logcat.sh",
    "native:android:logs:dump": "bash scripts/android-logcat.sh --dump",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "lint:packages": "eslint \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/vitest.config.ts\"",
    "lint:mobile": "eslint \"apps/mobile/**/*.{ts,tsx,js,mjs}\"",
    "lint:web": "eslint \"src/**/*.{ts,tsx}\" vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local | node scripts/patch-database-types.mjs | prettier --parser typescript > src/shared/api/database.types.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "preview": "vite preview",
    "backfill:photo-gps": "node --env-file=.env.local scripts/backfill-photo-gps.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/network": "^8.0.1",
    "@capawesome/capacitor-file-picker": "^8.0.2",
    "@trip-diary/config": "workspace:*",
    "@trip-diary/i18n": "workspace:*",
    "@trip-diary/core": "workspace:*",
    "@trip-diary/maps": "workspace:*",
    "@trip-diary/translation": "workspace:*",
    "@trip-diary/utils": "workspace:*",
    "@hookform/resolvers": "^5.4.0",
    "@supabase/supabase-js": "^2.108.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.3",
    "dexie-react-hooks": "^4.4.0",
    "exifr": "^7.1.3",
    "i18next": "^26.3.1",
    "lucide-react": "^1.17.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.78.0",
    "react-i18next": "^17.0.8",
    "tailwind-merge": "^3.6.0",
    "workbox-window": "^7.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  }
}
