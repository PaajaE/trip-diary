# Copy to `.env` for local Expo dev client runs.
# These values are not committed — obtain from your Supabase project dashboard.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Mapy.com tourist tiles (mapset `outdoor`). When unset, OSM fallback is used.
EXPO_PUBLIC_MAPY_API_KEY=

# External variable names are platform-specific (EXPO_PUBLIC_* here, VITE_* on web).
# The mobile adapter maps these into the neutral @trip-diary/config schema.
