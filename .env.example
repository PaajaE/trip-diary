VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SITE_URL=https://cestovni-denik.cz
VITE_MAPY_API_KEY=
# Cloudflare Turnstile SITE key (public) for guest hearts/comments. Leave empty locally.
# The secret goes only to the Supabase Auth captcha settings, never into the repo.
VITE_TURNSTILE_SITE_KEY=

# External variable names are platform-specific (VITE_* here, EXPO_PUBLIC_* on mobile).
# Apps map these into the neutral @trip-diary/config schema (supabaseUrl, mapyApiKey, …).

# Vite env loading (https://vite.dev/guide/env-and-mode):
#   pnpm dev       → .env.local (local Supabase at 127.0.0.1:54321)
#   pnpm dev:prod  → .env.production.local (production Supabase, overrides .env.local)
#
# Mapy.com basemap (REST API tiles): https://developer.mapy.com/
# Add VITE_MAPY_API_KEY to .env.production.local for Czech outdoor maps on the reader.


# Client-side photo analysis (perceptual hash + sharpness) stored in media.phash/quality.
# 'true' or 'false' (default false). Enable ONLY where the DB has those columns
# (local/CI; production after the migration is applied), else every upload fails.
VITE_MEDIA_ANALYSIS=false

# "Fix time and location" for photos (shift_media_time, set_media_location,
# clear_media_location RPCs). 'true' or 'false' (default false). Enable ONLY
# where the DB has those functions (local/CI; production after the migration).
VITE_MEDIA_CORRECTIONS=false
